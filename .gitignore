# RDD Framework .gitignore

# Sensitive files
.rdd/.keys/
.rdd/logs/
.rdd/cache/
*.key
*.pem
*.env
.env.*
secrets.yml
credentials.yml

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build artifacts
dist/
build/
*.tar.gz
*.zip

# Test coverage
coverage/
.nyc_output/

# Node modules (if used)
node_modules/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.log
