#!/usr/bin/env bash
set -euo pipefail
# Resolve npm's symlink as well as direct checkout/installed entrypoints.
rdd_entry="${BASH_SOURCE[0]}"
while [[ -L "$rdd_entry" ]]; do
  rdd_parent=$(cd "$(dirname "$rdd_entry")" && pwd)
  rdd_entry=$(readlink "$rdd_entry")
  [[ "$rdd_entry" == /* ]] || rdd_entry="$rdd_parent/$rdd_entry"
done
rdd_root=$(cd "$(dirname "$rdd_entry")/.." && pwd)
rdd_manager="$rdd_root/scripts/install/manage.py"
rdd_prefix="$rdd_root"
[[ -f "$rdd_root/install-manifest.json" ]] || rdd_prefix="${RDD_FRAMEWORK_HOME:-$HOME/.rdd-framework}"
command="${1:---help}"
[[ $# -eq 0 ]] || shift
case "$command" in
  install) exec python3 "$rdd_manager" install --source "$rdd_root" --prefix "$rdd_prefix" "$@" ;;
  upgrade) exec bash "$rdd_root/scripts/install/install.sh" --upgrade --prefix "$rdd_prefix" "$@" ;;
  uninstall) exec python3 "$rdd_manager" uninstall --prefix "$rdd_prefix" "$@" ;;
  init | migrate)
    project='.'
    if [[ $# -gt 0 && "$1" != -* ]]; then
      project="$1"
      shift
    fi
    exec python3 "$rdd_manager" "$command" --project "$project" "$@"
    ;;
  stage | knowledge)
    subcommand="${1:-help}"
    [[ $# -eq 0 ]] || shift
    exec task "$command:$subcommand" -- "$@"
    ;;
  doctor | status) exec task "$command" "$@" ;;
  version | --version | -v)
    if [[ -f "$rdd_root/VERSION" ]]; then
      version=$(cat "$rdd_root/VERSION")
    else
      version=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$rdd_root/package.json")
    fi
    echo "RDD Framework v${version#v}"
    ;;
  help | --help | -h)
    cat <<'EOF'
RDD Framework — Claude Code and Codex
Usage: rdd <command> [arguments]
  install [--agent claude|codex|both] [--prefix DIR] [--replace-skills]
  upgrade [--source DIR|--version TAG]
  uninstall                     Remove owned, unchanged installed assets
  init [NAME]                   Initialize a new RDD project
  migrate                       Add missing RDD assets without overwriting files
  stage <verify|gate|status>     Run shared stage tasks
  knowledge <adr|debt|handoff|check>
  doctor | status | --version
Claude Code: /rdd-help    Codex CLI/IDE: $rdd-help
Requirements: Python 3.8+, Bash; go-task and Git for project workflows.
EOF
    ;;
  *)
    echo "Unknown command: $command" >&2
    exit 2
    ;;
esac
